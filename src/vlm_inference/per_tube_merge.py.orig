"""Per-tube caption then merge: Global+ROI_i → event list_i → chronological caption.

Each tube is a separate VLM call with tube_story order (one Global, then that
tube's ROI crops). Event lists are merged with a text-only second call.
"""

from __future__ import annotations

import logging
import time
from dataclasses import dataclass, replace
from pathlib import Path
from typing import Any

from .inputs import Sample
from .metadata_format import (
    GlobalSection,
    VideoBundleMetadata,
    active_rois,
    format_input_order_dump_from_bundle,
)

logger = logging.getLogger(__name__)

PER_TUBE_MERGE_METHOD = "global_roi_per_tube_merge"
DEFAULT_MERGE_PROMPT_FILE = "prompts/merge_event_lists.txt"


@dataclass
class TubePass:
    roi_id: int
    t0: float
    t1: float
    num_global: int
    num_roi: int
    events: str
    latency_s: float | None = None
    token_stats: dict[str, int] | None = None
    error: str | None = None


@dataclass
class PerTubeMergeResult:
    caption: str
    tube_passes: list[TubePass]
    merge_prompt: str
    token_stats: dict[str, int] | None = None
    merge_latency_s: float | None = None
    total_latency_s: float | None = None
    merge_token_stats: dict[str, int] | None = None


def _sorted_globals(bundle: VideoBundleMetadata):
    return sorted(
        bundle.global_section.frames,
        key=lambda frame: (float(frame.timestamp), int(frame.frame_index)),
    )


def split_bundle_by_tube(bundle: VideoBundleMetadata) -> list[tuple[int, VideoBundleMetadata]]:
    """One sub-bundle per active ROI, paired with its start_only Global.

    Each ROI receives the Global frame nearest to its own start time. A Global
    can be reused when two ROI starts snap to the same sampled full frame.
    """
    rois = sorted(
        active_rois(bundle),
        key=lambda roi: (float(roi.time_range[0]), int(roi.roi_id)),
    )
    globals_ = _sorted_globals(bundle)
    out: list[tuple[int, VideoBundleMetadata]] = []
    for roi in rois:
        g_frames = ()
        if globals_:
            start = float(roi.time_range[0])
            nearest = min(
                globals_,
                key=lambda frame: (
                    abs(float(frame.timestamp) - start),
                    float(frame.timestamp),
                    int(frame.frame_index),
                ),
            )
            g_frames = (nearest,)
        sub = replace(
            bundle,
            global_section=GlobalSection(
                coverage=bundle.global_section.coverage,
                num_frames=len(g_frames),
                frames=g_frames,
            ),
            rois=(roi,),
        )
        out.append((int(roi.roi_id), sub))
    return out


def build_merge_prompt(template: str, passes: list[TubePass]) -> str:
    blocks: list[str] = []
    for i, item in enumerate(passes, start=1):
        events = (item.events or "").strip() or "(none)"
        blocks.append(
            f"ROI{item.roi_id} (motion region {i}, t={item.t0:.1f}s–{item.t1:.1f}s):\n{events}"
        )
    body = "\n\n".join(blocks)
    if "{event_lists}" in template:
        return template.replace("{event_lists}", body).strip()
    return f"{template.rstrip()}\n\n{body}".strip()


def _dump_tube_order(
    *,
    cfg,
    video_id: str,
    method: str,
    roi_id: int,
    bundle: VideoBundleMetadata,
) -> Path | None:
    out_dir = Path(cfg.output.dir) / "input_order"
    out_dir.mkdir(parents=True, exist_ok=True)
    order = cfg.experiment.input_order
    path = out_dir / f"{video_id}__{method}__tube{roi_id:02d}__{order}.txt"
    path.write_text(
        format_input_order_dump_from_bundle(bundle, input_order=order),
        encoding="utf-8",
    )
    return path


def run_per_tube_merge(
    *,
    captioner,
    sample: Sample,
    tube_prompt: str,
    merge_prompt_template: str,
    cfg,
    method: str,
) -> PerTubeMergeResult:
    if sample.bundle is None:
        raise ValueError("per-tube merge requires a metadata bundle")
    splits = split_bundle_by_tube(sample.bundle)
    if not splits:
        raise ValueError(f"{sample.sample_id}: no active ROI tubes")

    passes: list[TubePass] = []
    all_started = time.perf_counter()
    for roi_id, sub in splits:
        dump = _dump_tube_order(
            cfg=cfg,
            video_id=sample.sample_id,
            method=method,
            roi_id=roi_id,
            bundle=sub,
        )
        if dump is not None:
            logger.info("Wrote per-tube input order: %s", dump)
        tube_sample = Sample(
            job_name=f"{sample.job_name}__tube{roi_id:02d}",
            sample_id=sample.sample_id,
            input_type=sample.input_type,
            paths=sample.paths,
            sidecar_dirs=list(sample.sidecar_dirs),
            frame_width=sample.frame_width,
            frame_height=sample.frame_height,
            roi_bboxes_px=sample.roi_bboxes_px,
            bundle=sub,
            bundle_dir=sample.bundle_dir,
        )
        started = time.perf_counter()
        generated = captioner.generate(tube_sample, tube_prompt)
        latency_s = time.perf_counter() - started
        roi = sub.rois[0]
        passes.append(
            TubePass(
                roi_id=roi_id,
                t0=float(roi.time_range[0]),
                t1=float(roi.time_range[1]),
                num_global=len(sub.global_section.frames),
                num_roi=len(roi.frames),
                latency_s=latency_s,
                token_stats=generated.token_stats() or None,
                events=generated.text,
            )
        )
        logger.info(
            "  tube %s: global=%d roi=%d events=%d chars",
            roi_id,
            len(sub.global_section.frames),
            len(roi.frames),
            len(generated.text),
        )

    merge_prompt = build_merge_prompt(merge_prompt_template, passes)
    merge_started = time.perf_counter()
    merged = captioner.generate_text(merge_prompt)
    merge_latency_s = time.perf_counter() - merge_started
    stats = merged.token_stats() or None
    return PerTubeMergeResult(
        caption=merged.text,
        tube_passes=passes,
        merge_prompt=merge_prompt,
        token_stats=stats,
    )

        merge_latency_s=merge_latency_s,
        total_latency_s=time.perf_counter() - all_started,
        merge_token_stats=stats,

def tube_passes_as_dicts(passes: list[TubePass]) -> list[dict[str, Any]]:
    return [
        {
            "roi_id": p.roi_id,
            "t0": p.t0,
            "t1": p.t1,
            "num_global": p.num_global,
            "num_roi": p.num_roi,
            "events": p.events,
            "input_image_count": p.num_global + p.num_roi,
            "latency_s": p.latency_s,
            "token_stats": p.token_stats,
            "error": p.error,
        }
        for p in passes
    ]
